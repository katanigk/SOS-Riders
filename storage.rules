rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /riders/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /sos_chat/{eventId}/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
